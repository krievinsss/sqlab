# Obligātie. Izmanto atsevišķu Neon projekta datubāzi tikai SQL Lab lietotāju kontiem.
DATABASE_URL=postgresql://user:password@hostname/neondb?sslmode=require
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_64_CHARACTER_SECRET
CLASS_CODE=DB2026
ADMIN_USERNAME=skolotajs
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD

# PostgreSQL laboratorija: atsevišķs Neon projekts, kura admin loma spēj CREATE ROLE un CREATE SCHEMA.
# SVARĪGI: neizmanto TicketLab vai reālu skolas datubāzi!
PG_LAB_ADMIN_URL=postgresql://labadmin:password@hostname/neondb?sslmode=require

# MySQL laboratorija: atsevišķa MySQL instance ar CREATE DATABASE / CREATE USER / GRANT.
# Bez šī mainīgā MySQL izvēle būs atslēgta. Nepieciešama arī MySQL servera puse.
MYSQL_LAB_ADMIN_URL=mysql://admin:password@hostname:3306/mysql
MYSQL_LAB_SSL=true
